<Window x:Class="GameTranslate.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#11000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        KeyDown="Window_KeyDown">
  <Canvas x:Name="RootCanvas">
    <Border x:Name="SelectionBorder"
            Width="640"
            Height="180"
            BorderBrush="#2563EB"
            BorderThickness="2"
            Background="#22007AFF"
            Canvas.Left="240"
            Canvas.Top="360"
            MouseLeftButtonDown="SelectionBorder_MouseLeftButtonDown"
            MouseMove="SelectionBorder_MouseMove"
            MouseLeftButtonUp="SelectionBorder_MouseLeftButtonUp">
      <Grid>
        <TextBlock Text="拖动选择聊天区域"
                   Foreground="White"
                   FontWeight="SemiBold"
                   Background="#AA111827"
                   Padding="8,4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" />
      </Grid>
    </Border>

    <Rectangle x:Name="NorthWestHandle" Width="12" Height="12" Fill="#2563EB" Cursor="SizeNWSE"
               MouseLeftButtonDown="Handle_MouseLeftButtonDown" MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />
    <Rectangle x:Name="NorthEastHandle" Width="12" Height="12" Fill="#2563EB" Cursor="SizeNESW"
               MouseLeftButtonDown="Handle_MouseLeftButtonDown" MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />
    <Rectangle x:Name="SouthWestHandle" Width="12" Height="12" Fill="#2563EB" Cursor="SizeNESW"
               MouseLeftButtonDown="Handle_MouseLeftButtonDown" MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />
    <Rectangle x:Name="SouthEastHandle" Width="12" Height="12" Fill="#2563EB" Cursor="SizeNWSE"
               MouseLeftButtonDown="Handle_MouseLeftButtonDown" MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />

    <StackPanel x:Name="Toolbar"
                Orientation="Horizontal"
                Background="#DD111827">
      <TextBlock x:Name="RegionText"
                 Foreground="White"
                 VerticalAlignment="Center"
                 Margin="12,0"
                 MinWidth="220" />
      <Button Content="确定"
              Width="72"
              Height="32"
              Margin="0,6,6,6"
              Click="Confirm_Click" />
      <Button Content="取消"
              Width="72"
              Height="32"
              Margin="0,6,8,6"
              Click="Cancel_Click" />
    </StackPanel>
  </Canvas>
</Window>

