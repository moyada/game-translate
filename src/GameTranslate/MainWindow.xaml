<Window x:Class="GameTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Translate"
        Width="560"
        Height="390"
        MinWidth="460"
        MinHeight="300"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
  </Window.Resources>

  <Border Margin="0"
          Padding="20"
          BorderBrush="#BFD1D5DB"
          BorderThickness="1"
          Background="{Binding ElementName=OpacitySlider, Path=Value, Converter={StaticResource OpacityToBackgroundBrushConverter}}"
          MouseLeftButtonDown="WindowSurface_MouseLeftButtonDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Content="选择区域"
              Click="SelectRegion_Click" />
      <Button Grid.Column="1"
              Margin="12,0,0,0"
              Content="{Binding MonitoringButtonText}"
              Command="{Binding ToggleMonitoringCommand}" />
      <Button Grid.Column="2"
              Margin="12,0,0,0"
              Content="翻译"
              Command="{Binding TranslateCommand}" />
      <Button Grid.Column="4"
              Width="30"
              MinWidth="30"
              Padding="0"
              HorizontalAlignment="Right"
              Background="#DC2626"
              Content="X"
              Click="CloseButton_Click" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="透明度"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource MutedTextBrush}" />
      <Slider x:Name="OpacitySlider"
              Grid.Column="1"
              Margin="12,0"
              Minimum="0.3"
              Maximum="1"
              Value="1"
              TickFrequency="0.1"
              IsSnapToTickEnabled="False"
              VerticalAlignment="Center" />
      <TextBlock Grid.Column="2"
                 Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource MutedTextBrush}" />
    </Grid>

    <StackPanel Grid.Row="2"
                Margin="0,0,0,18">
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="{Binding CaptureRegionText}"
                 TextWrapping="Wrap" />
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="{Binding CaptureStatusText}"
                 Margin="0,4,0,0"
                 TextWrapping="Wrap" />
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="{Binding CaptureMetricsText}"
                 Margin="0,4,0,0" />
    </StackPanel>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="中文结果"
                 FontWeight="SemiBold"
                 Margin="0,0,0,8" />
      <TextBox Grid.Row="1"
               Text="{Binding TranslatedText}"
               AcceptsReturn="True"
               IsReadOnly="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               VerticalContentAlignment="Top"
               Background="{Binding ElementName=OpacitySlider, Path=Value, Converter={StaticResource OpacityToBackgroundBrushConverter}, ConverterParameter=White}" />
    </Grid>

  </Grid>
  </Border>
</Window>
