<Window x:Class="GameTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Translate"
        Width="560"
        Height="390"
        MinWidth="460"
        MinHeight="300"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Content="选择区域"
              Click="SelectRegion_Click" />
      <Button Grid.Column="1"
              Margin="12,0,0,0"
              Content="{Binding MonitoringButtonText}"
              Command="{Binding ToggleMonitoringCommand}" />
      <Button Grid.Column="2"
              Margin="12,0,0,0"
              Content="翻译 (Alt+`)"
              Command="{Binding TranslateCommand}" />
    </Grid>

    <Grid x:Name="PreviewPanel"
          Grid.Row="1"
          Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="92" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="OCR 截图"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="6">
          <Image Source="{Binding LatestCaptureImage}"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
      </Grid>

      <Grid Grid.Column="1" Margin="8,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="92" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="识别的英文"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding SourceText}"
                       TextWrapping="Wrap"
                       Foreground="#1F2937"
                       FontSize="13"
                       TextOptions.TextFormattingMode="Display" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="中文结果"
                 FontWeight="SemiBold"
                 Margin="0,0,0,8" />
      <Border Grid.Row="1"
              Background="#F7F8FA"
              BorderBrush="#D1D5DB"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding TranslatedText}"
                     TextWrapping="Wrap"
                     Foreground="#111827"
                     FontFamily="Microsoft YaHei UI"
                     FontSize="16"
                     FontWeight="SemiBold"
                     LineHeight="24"
                     LineStackingStrategy="BlockLineHeight"
                     TextOptions.TextFormattingMode="Display" />
        </ScrollViewer>
      </Border>
    </Grid>

    <Button x:Name="PreviewToggleButton"
            Grid.Row="3"
            Margin="0,12,0,0"
            MinWidth="84"
            Height="28"
            Padding="10,0"
            HorizontalAlignment="Left"
            Content="隐藏 OCR"
            Click="PreviewToggleButton_Click" />

  </Grid>
</Window>
