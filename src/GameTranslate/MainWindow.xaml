<Window x:Class="GameTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Translate"
        Width="980"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Game Translate" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Win10 / Win11 · WPF · LLamaSharp CUDA12 · unsloth/Qwen3-1.7B-GGUF:UD-Q4_K_XL"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,5,0,0" />
      </StackPanel>
      <Border DockPanel.Dock="Right"
              Background="#E5E7EB"
              CornerRadius="4"
              Padding="10,6"
              VerticalAlignment="Top">
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" />
      </Border>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0"
               Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="GGUF 模型路径" />
      <Button Grid.Column="1"
              Margin="12,0,0,0"
              Content="选择区域"
              Click="SelectRegion_Click" />
      <Button Grid.Column="2"
              Margin="12,0,0,0"
              Content="开始监控"
              Command="{Binding StartMonitoringCommand}" />
      <Button Grid.Column="3"
              Margin="12,0,0,0"
              Content="停止监控"
              Command="{Binding StopMonitoringCommand}" />
      <Button Grid.Column="4"
              Margin="12,0,0,0"
              Content="加载模型"
              Command="{Binding LoadModelCommand}" />
    </Grid>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="10,0,0,18">
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="{Binding CaptureRegionText}" />
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="  ·  " />
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="{Binding CaptureStatusText}" />
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="  ·  " />
      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                 Text="{Binding CaptureMetricsText}" />
    </StackPanel>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="识别到的英文" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right"
                Content="翻译"
                Command="{Binding TranslateCommand}" />
      </DockPanel>
      <TextBox Grid.Column="0"
               Grid.Row="1"
               Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               VerticalContentAlignment="Top" />

      <TextBlock Grid.Column="2"
                 Grid.Row="0"
                 Text="中文结果"
                 FontWeight="SemiBold"
                 Margin="0,0,0,8" />
      <Grid Grid.Column="2" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0"
                 Text="{Binding TranslatedText}"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" />
        <TextBlock Grid.Row="1"
                   Text="截图预览"
                   FontWeight="SemiBold"
                   Margin="0,12,0,8" />
        <Border Grid.Row="2"
                Background="#111827"
                BorderBrush="#D1D5DB"
                BorderThickness="1">
          <Image Source="{Binding LatestCaptureImage}"
                 Stretch="Uniform" />
        </Border>
        <TextBlock Grid.Row="3"
                   Text="{Binding OcrPreviewLabel}"
                   FontWeight="SemiBold"
                   Margin="0,12,0,8" />
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1">
          <Image Source="{Binding LatestOcrImage}"
                 Stretch="Uniform" />
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="4"
               Margin="0,14,0,0"
               Foreground="{StaticResource MutedTextBrush}"
               Text="第一版不选择目标窗口，直接使用全屏透明选择框选定聊天区域；截图、OCR、200ms 轮询会接到同一套区域数据。" />
  </Grid>
</Window>
