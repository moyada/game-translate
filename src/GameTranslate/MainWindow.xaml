<Window x:Class="GameTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Translate"
        Icon="Resources/Icons/logo.ico"
        Width="560"
        Height="560"
        MinWidth="460"
        MinHeight="160"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Content="选择区域"
              Click="SelectRegion_Click" />
      <Button Grid.Column="1"
              Margin="12,0,0,0"
              Content="{Binding MonitoringButtonText}"
              Command="{Binding ToggleMonitoringCommand}" />
      <Button Grid.Column="2"
              Margin="12,0,0,0"
              Content="翻译 (Alt+`)"
              Command="{Binding TranslateCommand}" />
    </Grid>

    <Grid x:Name="PreviewPanel"
          Grid.Row="1"
          Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="92" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="OCR 截图"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="6">
          <Image Source="{Binding LatestCaptureImage}"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
      </Grid>

      <Grid Grid.Column="1" Margin="8,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="92" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="识别的英文"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding SourceText}"
                       TextWrapping="Wrap"
                       Foreground="#1F2937"
                       FontSize="13"
                       TextOptions.TextFormattingMode="Display" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <Grid x:Name="TranslationResultPanel"
          Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="中文结果"
                 FontWeight="SemiBold"
                 Margin="0,0,0,8" />
      <Border Grid.Row="1"
              Background="#F7F8FA"
              BorderBrush="#D1D5DB"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12,10">
        <ScrollViewer x:Name="TranslationResultScrollViewer"
                      VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding TranslatedText}"
                     TextWrapping="Wrap"
                     Foreground="#111827"
                     FontFamily="Microsoft YaHei UI"
                     FontSize="15"
                     FontWeight="SemiBold"
                     LineHeight="24"
                     LineStackingStrategy="BlockLineHeight"
                     TextOptions.TextFormattingMode="Display" />
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="3"
          Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Left">
        <Button x:Name="PreviewToggleButton"
                MinWidth="84"
                Height="28"
                Padding="10,0"
                Content="隐藏 OCR"
                Click="PreviewToggleButton_Click" />
        <Button x:Name="FloatingToggleButton"
                Margin="10,0,0,0"
                MinWidth="84"
                Height="28"
                Padding="10,0"
                Content="悬浮窗"
                Click="FloatingToggleButton_Click" />
      </StackPanel>

      <Button HorizontalAlignment="Right"
              MinWidth="0"
              Height="28"
              Padding="0"
              Background="Transparent"
              Foreground="{StaticResource AccentBrush}"
              Content="企业智能体搭建"
              Click="AgentCardButton_Click" />
    </Grid>

    <Grid x:Name="AgentCardOverlay"
          Grid.RowSpan="4"
          Panel.ZIndex="10"
          Visibility="Collapsed"
          Background="#66000000">
      <Border Width="380"
              Padding="22"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="White"
              BorderBrush="#D1D5DB"
              BorderThickness="1"
              CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Button Grid.Row="0"
                  Width="28"
                  Height="28"
                  MinWidth="28"
                  Padding="0"
                  HorizontalAlignment="Right"
                  Background="#F3F4F6"
                  Foreground="#374151"
                  Content="↓"
                  Click="CloseAgentCardButton_Click" />

          <Image Grid.Row="1"
                 Width="240"
                 Height="240"
                 Margin="0,8,0,18"
                 HorizontalAlignment="Center"
                 Source="Resources/Images/agent-qr.jpg"
                 Stretch="Uniform" />

          <StackPanel Grid.Row="2">
            <TextBlock Text="软件专家 · 算法专家 · 流程顾问"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Text="为企业定制内部智能体、自动化工作流与效率优化方案"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#374151" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
